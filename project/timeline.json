 "subs": [
  {
   "t0": 0.08,
   "t1": 3.36,
   "ms": "Google nak labur 15 bilion USD di Malaysia.",
   "en": "Google wants to invest 15 billion USD in Malaysia."
  },
  {
   "t0": 3.4,
   "t1": 4.88,
   "ms": "Bagus, ya.",
   "en": "That's good."
  },
  {
   "t0": 4.92,
   "t1": 7.6,
   "ms": "Tapi kerja untuk rakyat kita, ada tak?",
   "en": "But are there jobs for our people?"
  },
  {
   "t0": 15.32,
   "t1": 18.12,
   "ms": "Sebab data center ini bukan sekadar bangunan penuh komputer.",
   "en": "Because a data centre isn't just a building full of computers."
  },
  {
   "t0": 18.12,
   "t1": 20.44,
   "ms": "Nak bina, nak jaga, nak urus \u2014",
   "en": "Building it, maintaining it, managing it \u2014"
  },
  {
   "t0": 20.44,
   "t1": 22.32,
   "ms": "semuanya perlukan tenaga kerja.",
   "en": "all of it needs a workforce."
  },
  {
   "t0": 22.48,
   "t1": 25.88,
   "ms": "Jurutera, juruteknik, kontraktor, orang logistik.",
   "en": "Engineers, technicians, contractors, logistics people."
  },
  {
   "t0": 26.04,
   "t1": 27.68,
   "ms": "Google jangka pelaburan terbaru ini",
   "en": "Google expects this latest investment"
  },
  {
   "t0": 27.68,
   "t1": 32.44,
   "ms": "akan menyokong lebih 37 ribu pekerjaan setahun semasa pembinaan.",
   "en": "to support more than 37,000 jobs a year during construction."
  },
  {
   "t0": 33.04,
   "t1": 36.72,
   "ms": "Bila beroperasi nanti, lebih 9 ribu pekerjaan setahun.",
   "en": "Once operational, more than 9,000 jobs a year."
  },
  {
   "t0": 37.12,
   "t1": 39.84,
   "ms": "Ini kerja yang diwujudkan oleh ekosistem Google,",
   "en": "These are jobs created by Google's ecosystem \u2014"
  },
  {
   "t0": 40.48,
   "t1": 41.92,
   "ms": "bukan semuanya dengan Google.",
   "en": "not all of them with Google itself."
  },
  {
   "t0": 42.04,
   "t1": 43.76,
   "ms": "Bagi saya, ukuran kejayaan",
   "en": "For me, the measure of success"
  },
  {
   "t0": 43.8,
   "t1": 47.24,
   "ms": "bukan berapa bilion pelaburan diumumkan,",
   "en": "isn't how many billions in investment are announced,"
  },
  {
   "t0": 47.32,
   "t1": 50.72,
   "ms": "tapi berapa ramai rakyat Malaysia dapat kerja yang bagus,",
   "en": "but how many Malaysians get good jobs,"
  },
  {
   "t0": 51.04,
   "t1": 53.6,
   "ms": "dan berapa banyak syarikat tempatan dapat peluang.",
   "en": "and how many local companies get opportunities."
  },
  {
   "t0": 53.8,
   "t1": 56.24,
   "ms": "Itu yang kita kena pastikan.",
   "en": "That is what we must make sure of."
  }
 ],
